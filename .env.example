# Native development: copy to .env so Next.js and Prisma CLI both load it.
# This file contains examples only. Never commit your filled-in .env.

# REQUIRED: replace with a value from openssl rand -base64 32.
# Preserve it: stored provider credentials depend on this secret.
AUTH_SECRET=replace-with-a-generated-secret
AUTH_URL=http://localhost:4250

# Relative to prisma/schema.prisma, NOT the repository root.
# Matches the CLI schema default; creates prisma/dev.db.
DATABASE_URL=file:./dev.db

# Optional installation limits. Later registrations also require an invite.
# MVP_USER_LIMIT=10
# MVP_STORAGE_LIMIT_DEFAULT=1073741824

# Optional exact origins allowed for non-owner custom endpoints. No paths.
# Owner endpoints are not restricted by this list. Empty denies non-owner origins.
# LLM_ALLOWED_PROVIDER_ORIGINS=https://gateway.example.com,http://localhost:11434

# Optional native video binary overrides. Docker supplies system binaries.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional client error-log ingestion. Disabled by default in production.
# ENABLE_CLIENT_ERROR_LOGS=false

# Optional analytics: disabled by default; authenticated user consent also required.
# NEXT_PUBLIC_* values are embedded when building the browser bundle.
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
