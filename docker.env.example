# Docker: copy to docker.env. Run Compose with --env-file docker.env so the
# same file supplies service configuration and Compose variable interpolation.
# Examples only; never commit a filled-in docker.env.

# Set to the exact HTTPS URL for remote use, including a nondefault public port.
AUTH_URL=http://localhost:4250

# Leave unset for Docker to generate/persist /app/prisma/.auth.secret.
# Existing volume secrets take precedence on later starts. Back up that file.
# For a fresh installation only, you may provide a securely generated value:
# AUTH_SECRET=replace-with-a-generated-secret

# Runtime default supplied by Compose; keep the persistent /app/prisma volume.
# DATABASE_URL=file:/app/prisma/dev.db

# Optional limits. The first registered user becomes owner; later users need invites.
# MVP_USER_LIMIT=10
# MVP_STORAGE_LIMIT_DEFAULT=1073741824

# Optional exact origins allowed for non-owner custom endpoints, without paths.
# Empty denies non-owner origins. Container requests must reach these addresses.
# LLM_ALLOWED_PROVIDER_ORIGINS=https://gateway.example.com,http://model-server:11434

# Optional diagnostic ingestion. Disabled by default in production.
# ENABLE_CLIENT_ERROR_LOGS=false

# Public analytics values are build-time settings. Putting them only in this
# runtime file does not configure the shipped browser bundle. Disabled by default.
